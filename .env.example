# Google Gemini API key used by the /api/description and /api/budget routes.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side only, never expose to the client.
# Used for privileged operations that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Monetization). Get these from the Stripe Dashboard.
# Secret key: Developers -> API keys (use a test-mode key while developing).
STRIPE_SECRET_KEY=
# Price ID for the Pro monthly subscription: Product catalog -> your
# product -> the price's ID (starts with "price_").
STRIPE_PRICE_ID=
# Webhook signing secret: Developers -> Webhooks -> your endpoint -> "Signing secret".
STRIPE_WEBHOOK_SECRET=
