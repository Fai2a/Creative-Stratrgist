# Google Gemini API key used by the /api/description and /api/budget routes.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side only, never expose to the client.
# Used for privileged operations that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Paddle (Monetization). Get these from the Paddle Dashboard.
# "sandbox" while testing, "production" once you're accepted and switch over.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Developer Tools -> Authentication -> Client-side tokens. Safe to expose to
# the browser (used to open the Paddle.js checkout overlay).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Catalog -> Products -> your product -> the price's ID (starts with "pri_").
NEXT_PUBLIC_PADDLE_PRICE_ID=
# Developer Tools -> Authentication -> API keys. Server-side only.
PADDLE_API_KEY=
# Developer Tools -> Notifications -> your webhook destination -> secret key.
PADDLE_WEBHOOK_SECRET=
