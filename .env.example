# Anthropic API key used by the /api/description and /api/budget routes.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side only, never expose to the client.
# Used for privileged operations that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
